# ============================================================
#   复制本文件为 .env，然后按需填写
#   命令：Copy-Item .env.example .env
# ============================================================

# ---------- 用哪个模型 ----------
# openai = 任何兼容 OpenAI 协议的服务（OpenAI / DeepSeek / vLLM / 中转站）
# ollama = 本地模型（需先装 Ollama 并 ollama pull 模型）
# fake   = 离线假模型，不联网、不花钱，用来先把代码结构跑通
LLM_PROVIDER=openai

# ---------- OpenAI 兼容服务 ----------
OPENAI_API_KEY=sk-xxx
# 下面这组是 DeepSeek 的写法（当前课程使用）：
#   OPENAI_BASE_URL=https://api.deepseek.com   或  https://api.deepseek.com/v1
#   MODEL_NAME=deepseek-flash                  或  deepseek-chat / deepseek-v4-pro
# 换成 OpenAI 官方就填 https://api.openai.com/v1 + gpt-4o-mini
# 中转站填它给的地址；本地 vLLM 填 http://127.0.0.1:8000/v1
OPENAI_BASE_URL=https://api.deepseek.com
MODEL_NAME=deepseek-flash

# ---------- Ollama 本地模型 ----------
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b
